{
    "name": ":lc:vendor/:lc:package",
    "description": ":package_description",
    "license": ":license",
    "authors": [
        {
            "name": ":author_name",
            "email": ":author_email",
            "homepage": ":author_homepage"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.3r.media"
        }
    ],
    "homepage": "https://github.com/:lc:vendor/:lc:package",
    "keywords": ["Laravel", "3r.media", ":uc:package"],
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^11.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20.0",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.6.1",
        "orchestra/testbench": "^9.10.0",
        "pestphp/pest": "^v3.7.4",
        "pestphp/pest-plugin-arch": "^v3.0.0",
        "pestphp/pest-plugin-laravel": "^v3.1.0",
        "pestphp/pest-plugin-livewire": "^v3.0.0"
    },
    "autoload": {
        "psr-4": {
            "Rrr\\:uc:package\\": "src/",
            "Rrr\\:uc:package\\Database\\Factories\\": "database/factories/",
            "Rrr\\:uc:package\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rrr\\:uc:package\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rrr\\:uc:package\\:uc:packageServiceProvider"
            ],
            "aliases": {
                ":uc:package": "Rrr\\:uc:package\\Facades\\:uc:package"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
